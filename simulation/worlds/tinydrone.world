<?xml version="1.0" ?>
<!--
  tinydrone.world — sanal askeri saha
  Hedefler: tank + hangar (basit geometrik modeller — ilk POC)
  Not: ArduPilot iris modeli ayrıca eklenir (iris_ardupilot.world referansı)
-->
<sdf version="1.6">
  <world name="tinydrone_world">
    <physics type="ode">
      <gravity>0 0 -9.8</gravity>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Güneş + gökyüzü -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Zemin (düz arazi — ileride heightmap ile gerçekçi arazi) -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>500 500</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>500 500</size></plane>
          </geometry>
          <material><ambient>0.45 0.4 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- HEDEF 1: Tank (basit kutu + gövde) -->
    <model name="tank_target">
      <static>true</static>
      <pose>20 15 0 0 0 0.5</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>3.0 1.8 1.2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>3.0 1.8 1.2</size></box></geometry>
          <material><ambient>0.2 0.35 0.15 1</ambient><diffuse>0.25 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="turret">
        <pose>0 0 1.2 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.5</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.45 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- HEDEF 2: Hangar/bina -->
    <model name="hangar_target">
      <static>true</static>
      <pose>-25 10 0 0 0 0.2</pose>
      <link name="building">
        <collision name="col">
          <geometry><box><size>12 15 5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>12 15 5</size></box></geometry>
          <material><ambient>0.55 0.55 0.5 1</ambient><diffuse>0.6 0.6 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- HEDEF 3: Zırhlı araç (hareketli olabilir — ileride plugin) -->
    <model name="armored_target">
      <static>true</static>
      <pose>5 -20 0 0 0 -0.3</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>2.2 1.4 0.9</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>2.2 1.4 0.9</size></box></geometry>
          <material><ambient>0.3 0.3 0.25 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Kamera izleme noktası (yerden drone görüşü testi) -->
    <model name="camera_mast">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="mast">
        <visual name="vis">
          <geometry><cylinder><radius>0.1</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
